{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit",
        "hooks": [
          {"type": "command", "command": "python3 .claude/ai-sdlc/hooks/guard.py", "timeout": 5}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python3 .claude/ai-sdlc/hooks/stop.py", "timeout": 10}
        ]
      }
    ]
  }
}
